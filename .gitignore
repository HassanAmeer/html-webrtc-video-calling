# Node.js
node_modules/
npm-debug.log
yarn-error.log

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Compiled binary addons (https://github.com/nodejs/node-gyp#configuring-to-use-a-proxy)
build

# Dependency directories
jspm_packages/
typings/

# Typescript v1 declaration files
*.ts

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Binary APK builds
*.apk
*.class
remoteapk/**/build/
remoteapk/.gradle/
remoteapk/local.properties

# Runtime state — must NEVER be committed. devices.json holds live device
# registry + ghost state and is rewritten by the server at runtime; a git pull
# or deploy would otherwise conflict with it or resurrect stale devices.
devices.json
devices.json.tmp
crash.log
persistent_logs.jsonl
vapid.json
push-subscriptions.json
push-subscriptions.json.tmp

# Agents
.agents/
